# Auth

# Public URL of the app. Also the base for the OAuth callback below.
AUTH_URL=http://localhost:3000
# Long random string that encrypts the session cookie: `openssl rand -base64 32`
AUTH_SECRET=
# Optional. Comma-separated extra origins allowed to call the auth API.
AUTH_TRUSTED_ORIGINS=

# GitHub

# Register a GitHub OAuth App at https://github.com/settings/developers
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
